# Postgres do docker compose, exposto em localhost:5432
DATABASE_URL=postgres://giro:giro@localhost:5432/giro

# API
PORT=3333
LOG_LEVEL=info

# Token do bot criado no @BotFather. Vazio = API sobe com o bot desativado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=true

# Token exigido pela API (header Authorization: Bearer <token>). Vazio = sem autenticação.
# Defina antes de expor a API fora da sua máquina; o painel pede o token uma vez.
API_TOKEN=

# Rotina diária de sugestões (gera, expira as sem resposta e envia às lojas com envio automático).
JOBS_ENABLED=false
SUGGESTION_CRON=30 5 * * *
JOBS_TIMEZONE=America/Sao_Paulo

{
  "name": "@giro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --import tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures:pdv": "tsx scripts/gerar-exemplos-pdv.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@giro/shared": "workspace:*",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "grammy": "^1.46.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
